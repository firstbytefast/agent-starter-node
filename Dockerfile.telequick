# syntax=docker/dockerfile:1
#
# Run the starter agent over TeleQuick QUIC transport (no LiveKit server).
#
# Build:  docker build -f Dockerfile.telequick -t cc-starter-agent-node .
# Run:    docker run -d --name cc-starter-agent-node \
#           -e CC_APP_KEY=... -e CC_SECRET=... -e CC_AGENT=salesbot \
#           -e OPENAI_API_KEY=... -e DEEPGRAM_API_KEY=... \
#           cc-starter-agent-node
#
# Differs from the stock Dockerfile in three places, all of them consequences of
# there being no LiveKit server in this deployment:
#   * pnpm 11, because pnpm-workspace.yaml's `allowBuilds:` (which lets
#     onnxruntime-node fetch Silero's native runtime) is a pnpm 10.4+ key that
#     pnpm 10.0 ignores.
#   * `livekit-agents download-files` is dropped: it pre-fetches LiveKit
#     Inference model files, and this image uses provider plugins instead.
#   * CMD runs the TeleQuick worker rather than `pnpm start`.
ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV HOME="/app"

RUN apt-get update -qq && apt-get install --no-install-recommends -y ca-certificates && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11

FROM base AS build
WORKDIR /app

# .npmrc carries the @telequick scope registry, and pnpm-workspace.yaml carries
# the build allowlist — both are needed for the install below, so they are part
# of the cached dependency layer.
COPY package.json pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm prune --prod

FROM base

ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/app" \
    --shell "/sbin/nologin" \
    --uid "${UID}" \
    appuser

WORKDIR /app
COPY --from=build --chown=appuser:appuser /app /app
USER appuser

ENV NODE_ENV=production

# Registers the agent with the engine over QUIC and waits for dispatched calls.
CMD [ "pnpm", "telequick" ]
